    <changeSet id="1783587743714-10"
               author="minhdat">
        <addForeignKeyConstraint baseColumnNames="owner_application_id"
                                 baseTableName="addresses"
                                 constraintName="FK_ADDRESSES_ON_OWNER_APPLICATION"
                                 referencedColumnNames="owner_application_id"
