    <changeSet id="1783587743714-7"
               author="minhdat">
        <addUniqueConstraint columnNames="owner_application_id"
                             constraintName="uc_addresses_owner_application"
                             tableName="addresses"/>
    </changeSet>
    <changeSet id="1783587743714-8"
               author="minhdat">
