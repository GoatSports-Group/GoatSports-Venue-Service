    <changeSet id="1783587743714-14"
               author="minhdat">
        <addForeignKeyConstraint baseColumnNames="owner_application_id"
                                 baseTableName="venue_owner_profiles"
                                 constraintName="FK_VENUE_OWNER_PROFILES_ON_OWNER_APPLICATION"
