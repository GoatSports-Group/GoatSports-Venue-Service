                                 baseTableName="venues"
                                 constraintName="FK_VENUES_ON_VENUE_OWNER_PROFILE"
                                 referencedColumnNames="venue_owner_profile_id"
                                 referencedTableName="venue_owner_profiles"/>
    </changeSet>
    <changeSet id="1783587743714-13"
               author="minhdat">
        <addForeignKeyConstraint baseColumnNames="venue_id"
