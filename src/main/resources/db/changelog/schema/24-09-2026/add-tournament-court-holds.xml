<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-5.0.xsd">

    <changeSet id="20260924-create-court-holds" author="codex">
        <comment>San giai dau giu trong thoi gian giai: chan dat san thuong trong khung gio thi dau</comment>
        <createTable tableName="court_holds">
            <column name="hold_id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tournament_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="venue_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="venue_court_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_court_holds_court"
                             referencedTableName="venue_courts" referencedColumnNames="venue_court_id"/>
            </column>
            <column name="from_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="to_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="daily_start" type="TIME">
                <constraints nullable="false"/>
            </column>
            <column name="daily_end" type="TIME">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP"/>
        </createTable>
        <sql>ALTER TABLE court_holds ADD CONSTRAINT ck_court_holds_range
            CHECK (to_date &gt;= from_date AND daily_end &gt; daily_start)</sql>
        <createIndex tableName="court_holds" indexName="idx_court_holds_court_dates">
            <column name="venue_court_id"/>
            <column name="from_date"/>
            <column name="to_date"/>
        </createIndex>
        <createIndex tableName="court_holds" indexName="idx_court_holds_tournament">
            <column name="tournament_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
